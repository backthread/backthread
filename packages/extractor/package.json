{
  "name": "@backthread/extractor",
  "version": "0.15.0",
  "description": "Deterministic, install-free structural extraction for TypeScript, Python, Ruby, Elixir, PHP, Kotlin, Dart/Flutter, and Swift codebases — AST → communities → god-nodes → framework & infra adapters, zero LLM/DB/network.",
  "type": "module",
  "license": "MIT",
  "author": "Backthread",
  "homepage": "https://github.com/backthread/backthread/tree/main/packages/extractor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backthread/backthread.git",
    "directory": "packages/extractor"
  },
  "bugs": "https://github.com/backthread/backthread/issues",
  "keywords": [
    "ast",
    "code-graph",
    "static-analysis",
    "typescript",
    "python",
    "ruby",
    "elixir",
    "php",
    "kotlin",
    "dart",
    "flutter",
    "swift",
    "louvain",
    "architecture"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "comment_test_isolation": "`--experimental-test-isolation=none` runs the test files in one process instead of forking one child per file. Not a speed tweak: the forked runner rebuilds its report by parsing each child's stdout, which misframes across pipe-chunk boundaries and fails with `Unable to deserialize cloned data` against a test file that passed (measured: 3 of 10 CI runs, 0 of 10 in-process). Full reasoning and the trade-off in .github/workflows/ci.yml.",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test --experimental-test-isolation=none --test-force-exit \"src/**/*.test.ts\" && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ruby/prism": "^1.9.0",
    "@zzzen/pyright-internal": "1.2.0-dev.20251207",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "php-parser": "^3.7.0",
    "smol-toml": "^1.8.0",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "expect": "^30.5.0",
    "jest-mock": "^30.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
